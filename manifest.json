{
  "manifest_version": 3,
  "name": "点睛网 · 自动刷课助手",
  "version": "1.8.0",
  "description": "自动播放/续播点睛网课程视频，播完自动进入下一节，强制倍速、静音与弹题暂停提醒。",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.zfwx.com/*",
    "*://*.dianjingyun.com/*"
  ],
  "action": {
    "default_title": "点睛网自动刷课",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.zfwx.com/*",
        "*://zfwx.com/*",
        "*://*.dianjingyun.com/*"
      ],
      "js": [
        "src/rate-lock.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN",
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "*://*.zfwx.com/*",
        "*://zfwx.com/*",
        "*://*.dianjingyun.com/*"
      ],
      "js": [
        "src/same-tab.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN",
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "*://*.zfwx.com/*",
        "*://zfwx.com/*",
        "*://*.dianjingyun.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/rate-lock.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
